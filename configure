#!/bin/sh

. "$(dirname "$0")/tconf.sh"

: ${STATIC:="yes"}
: ${SHARED:="yes"}
OPTIONS="STATIC SHARED PLATFORM"

tconf_init "$@"

tconf_search_cc "$HOST"
tconf_find_os

OS="${HOST#*-}"

if test "$OS" = "stanix" ; then
	PLATFORM="twm"
else
	PLATFORM="x11"
fi

case $PLATFORM in
	twm)
		LDFLAGS="$LDFLAGS -ltwm -lgfx"
		;;
	x11)
		LDFLAGS="$LDFLAGS -lX11 -lXft -lXrender"
		CFLAGS="$CFLAGS -I\$(PREFIX)/include/freetype2"
		;;
	*)
		echo "unknown platform '$PLATFORM'"
		exit 1
		;;
esac

tconf_gen_makefiles "$SRCDIR/Makefile.in" "$SRCDIR/test/Makefile.in"

tconf_fini
