TMAKE_DIR = $(TOP)/make
include $(TMAKE_DIR)/tmake-init.mk

LIB = tgui
INCSDIR = $(PREFIX)/include/tgui
INCS = $(wildcard $(SRCDIR)/include/tgui/*.h)
SRCS = $(wildcard $(SRCDIR)/src/*.c) $(SRCDIR)/platform/$(PLATFORM).c
CFLAGS += -I$(SRCDIR)/include/tgui
include $(TMAKE_DIR)/tmake-lib.mk 

SUBDIRS = test
include $(TMAKE_DIR)/tmake-subdir.mk 

all-test : $(BUILDDIR)/$(SHARED_LIB)
